# Cloudflare Pages — https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# Fingerprinted build assets never change — cache them hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Blog post pages are the one thing allowed to be framed — the gated admin
# panel embeds a PR's preview-deployment post in a review pane. Drop the
# inherited X-Frame-Options: DENY (it can't express an allowlist) and use a
# CSP frame-ancestors that permits only same-origin and the production admin
# origin. Applies on preview deployments too (that's the point — the admin
# panel on the production domain frames a <hash>.andilekhumalo.pages.dev post).
/blog/*
  ! X-Frame-Options
  Content-Security-Policy: frame-ancestors 'self' https://andilekhumalo.pages.dev

/api/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# Gated admin area — never indexed, never cached (Cloudflare Access is the
# actual gate; this is defense-in-depth, not the auth itself). Content-Type
# is set explicitly because these paths serve dist/admin-shell (see
# public/_redirects), which has no file extension for Cloudflare to infer a
# type from — _headers rules match the REQUESTED path, not the _redirects
# rewrite target, so they're declared here rather than on /admin-shell.
/admin
  Content-Type: text/html; charset=utf-8
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/admin/*
  Content-Type: text/html; charset=utf-8
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
