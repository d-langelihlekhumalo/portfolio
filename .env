# Public site origin (no trailing slash) — used for canonical / Open Graph URLs at build time.
# Committed default. Production overrides this via the Cloudflare Pages env var
# (Settings -> Environment variables), which Vite gives precedence over this file.
# Update it here too once your custom domain is live, e.g. https://andilekhumalo.dev
VITE_SITE_URL=https://andilekhumalo.pages.dev
