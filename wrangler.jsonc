{
  // Cloudflare Pages project config — https://developers.cloudflare.com/pages/functions/wrangler-configuration/
  // "name" becomes the project and its *.pages.dev subdomain. Change it before the first deploy if you want a different subdomain.
  "name": "andilekhumalo",
  "compatibility_date": "2025-09-04",
  "pages_build_output_dir": "dist"

  // Optional — syncs /admin/roadmap progress and the /admin/salary profile
  // across devices. Without it, both are saved per-browser. Create the
  // namespace once with
  //   npx wrangler kv namespace create ADMIN_KV
  // then uncomment below (add a comma after the line above) and paste the id.
  // (The older binding name ROADMAP_KV is still accepted.)
  // "kv_namespaces": [{ "binding": "ADMIN_KV", "id": "<namespace-id>" }]
}
